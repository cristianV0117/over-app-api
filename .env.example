GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=
FRONTEND_URL=

JWT_SECRET=

MONGO_STRING=
MONGO_DATABASE=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Avatares: se guardan en ./uploads (no config necesario)

# Asistente de contabilidad (OpenAI-compatible; también Gemini vía base URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Workana (solo admin). Pega el header Cookie de una sesión iniciada.
# No subas este valor a git. Si lo pegaste en un chat, rota la sesión.
WORKANA_COOKIE=
WORKANA_QUERIES=php,nestjs,typescript